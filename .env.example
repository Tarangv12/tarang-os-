# ---------------------------------------------------------------------------
# TarangOS configuration
#
# Copy this file to `.env` and edit. Every value has a safe default, so the app
# starts without any of them — but set the secrets before you expose it beyond
# your own laptop.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4517
HOST=0.0.0.0

# SQLite location, relative to server/prisma/. Leave as-is for the default
# ./data folder at the project root.
DATABASE_URL="file:../../data/tarangos.db"

# ---------------------------------------------------------------------------
# Secrets  (generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# If you leave these blank they are generated once and stored in data/.secrets.json.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
SESSION_PEPPER=

# ---------------------------------------------------------------------------
# First-run account (optional). If set, you can still create the account in the
# browser — these are only a convenience for scripted installs.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions & locking
# ---------------------------------------------------------------------------
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_DAYS=30
AUTO_LOCK_MINUTES=20
MAX_FAILED_LOGINS=7
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# ---------------------------------------------------------------------------
# Cookies
#
# Cookies are Secure by default, which requires HTTPS. If you access TarangOS
# over plain http:// on your own LAN, set this to true.
# ---------------------------------------------------------------------------
ALLOW_INSECURE_COOKIE=false
COOKIE_SAMESITE=strict

# ---------------------------------------------------------------------------
# Reverse proxy
#
# Set this to true ONLY when TarangOS actually sits behind a proxy you control
# (Caddy, nginx, Cloudflare Tunnel, Tailscale Funnel).
#
# It makes the X-Forwarded-For header authoritative for identifying callers.
# Behind a real proxy that is correct and necessary. Exposed directly, it would
# let anyone forge their own address and walk straight through rate limiting
# and IP blocking — so leave it false unless a proxy is genuinely in front.
# ---------------------------------------------------------------------------
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# TLS (optional). Point these at a certificate to serve HTTPS directly, so
# phone access over Wi-Fi is encrypted. See README for generating one.
# ---------------------------------------------------------------------------
TLS_KEY_FILE=
TLS_CERT_FILE=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
AUTO_BACKUP=true
BACKUP_KEEP=30

# ---------------------------------------------------------------------------
# TarangOS configuration
#
# Copy to `.env` for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead — there is no .env file
# on a serverless deployment.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4517
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database  (REQUIRED)
#
# TarangOS stores everything in Postgres. Free options that work well with
# serverless: Neon (neon.tech), Supabase, Vercel Postgres.
#
# DATABASE_URL  pooled connection — what the app uses at runtime
# DIRECT_URL    direct connection — used only for migrations, which cannot run
#               through a transaction pooler. If your provider gives you one
#               URL, set both to the same value.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/tarangos?sslmode=require"
DIRECT_URL="postgresql://user:password@host/tarangos?sslmode=require"

# ---------------------------------------------------------------------------
# Secrets  (REQUIRED in production — generate once, then never change)
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SESSION_PEPPER is mixed into your password hash. If it changes, your existing
# password stops working and you are locked out of your own account.
#
# Left blank on a normal server they are generated into data/.secrets.json.
# On serverless there is nowhere durable to keep them, so startup fails loudly
# rather than inventing new ones on every cold start.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=
SESSION_PEPPER=

# Shared secret for the scheduled housekeeping endpoint (/api/cron/housekeeping).
# Vercel sends this automatically as a Bearer token once it is set.
CRON_SECRET=

# ---------------------------------------------------------------------------
# First-run account (optional). You can also just create it in the browser.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=tarangv61@gmail.com
ADMIN_PASSWORD=Tarang@89340#

# ---------------------------------------------------------------------------
# Sessions & locking
# ---------------------------------------------------------------------------
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_DAYS=30
AUTO_LOCK_MINUTES=20
MAX_FAILED_LOGINS=7
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# ---------------------------------------------------------------------------
# Cookies
#
# Cookies are Secure by default, which requires HTTPS. Vercel always serves
# HTTPS, so leave this false there. Set it true only for plain-http access on
# your own LAN.
# ---------------------------------------------------------------------------
ALLOW_INSECURE_COOKIE=false
COOKIE_SAMESITE=strict

# ---------------------------------------------------------------------------
# Reverse proxy
#
# Set true ONLY when TarangOS sits behind a proxy you control — including
# Vercel, whose edge sets X-Forwarded-For for you.
#
# It makes that header authoritative for identifying callers. Behind a real
# proxy that is correct and necessary. Exposed directly, it would let anyone
# forge their own address and walk straight through rate limiting and IP
# blocking.
# ---------------------------------------------------------------------------
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# TLS (optional, self-hosted only). Not used on Vercel.
# ---------------------------------------------------------------------------
TLS_KEY_FILE=
TLS_CERT_FILE=

# ---------------------------------------------------------------------------
# Backups
#
# Backup *files* need a disk that survives between requests, so they are
# switched off automatically on serverless. Export/Import still work there.
# ---------------------------------------------------------------------------
AUTO_BACKUP=true
BACKUP_KEEP=30

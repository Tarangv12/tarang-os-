{
  "name": "tarangos-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/deployDb.mjs",
    "db:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/notifications.test.mjs && node test/abuse.test.mjs",
    "test:abuse": "node test/abuse.test.mjs",
    "test:abuse:e2e": "node test/abuse-e2e.mjs",
    "test:smoke": "node test/smoke.mjs",
    "backup": "tsx src/scripts/backup.ts",
    "reset-admin": "tsx src/scripts/resetAdmin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "prisma": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

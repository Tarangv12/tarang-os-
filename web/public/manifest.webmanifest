{
  "name": "TarangOS — Personal Productivity System",
  "short_name": "TarangOS",
  "description": "A private, secure personal productivity system: tasks, habits, focus, goals and 6+ months of history — stored on your own machine.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0b0f",
  "theme_color": "#12141b",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "short_name": "Today", "url": "/today", "description": "Today's tasks" },
    { "name": "Focus", "short_name": "Focus", "url": "/focus", "description": "Start a focus session" },
    { "name": "Reviews", "short_name": "Review", "url": "/reviews", "description": "End-of-day review" }
  ]
}

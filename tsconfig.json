{
  "//": "Type configuration for the Vercel serverless functions in /api. The web and server packages each have their own tsconfig; this one only covers the thin handlers that wrap the Express app.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "typeRoots": ["./server/node_modules/@types", "./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules", "web", "server/dist", "**/dist"]
}
